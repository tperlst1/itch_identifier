
import numpy as np
import pytest

from src.itch_identifier import ItchIdentifier
from src import frontend


def make_app():

    # Avoid loading YOLO weights during unit tests.
    app = ItchIdentifier.__new__(ItchIdentifier)

    app.distance_estimator = None
    app.paused = False
    app.frame_number = 0
    app.device = "cpu"

    app.classification_model = (
        ItchIdentifier.SPECIES_CLASSIFICATION.copy()
    )

    return app


def make_detection(
    hazard="dangerous",
    distance=None,
    confidence=0.98,
):

    return {
        "species": "Giant Hogweed",
        "confidence": confidence,
        "hazard": hazard,
        "bbox": (10, 10, 100, 100),
        "distance_m": distance,
    }


def test_classification():

    app = make_app()

    assert (
        app.label_function("Giant Hogweed")
        == "dangerous"
    )

    assert (
        app.label_function("Unknown Plant")
        == "uncertain"
    )


def test_low_confidence_is_uncertain():

    app = make_app()

    assert 0.94 < app.CONFIDENCE_THRESHOLD


def test_dangerous_plant_count():

    app = make_app()

    detections = [
        make_detection(),
        make_detection(),
        make_detection(hazard="uncertain"),
    ]

    assert app.count_dangerous_plants(
        detections
    ) == 2


def test_area_threshold():

    app = make_app()

    detections = [
        make_detection()
        for _ in range(11)
    ]

    frame = np.zeros(
        (480, 640, 3),
        dtype=np.uint8
    )

    _, unsafe, count = app.area_signal(
        frame,
        detections
    )

    assert unsafe is True
    assert count == 11


def test_area_threshold_not_exceeded():

    app = make_app()

    detections = [
        make_detection()
        for _ in range(10)
    ]

    frame = np.zeros(
        (480, 640, 3),
        dtype=np.uint8
    )

    _, unsafe, count = app.area_signal(
        frame,
        detections
    )

    assert unsafe is False
    assert count == 10


def test_distance_estimation():

    app = make_app()

    class MockEstimator:

        def estimate(self, bbox):
            return 0.2

    app.distance_estimator = MockEstimator()

    detections = [
        make_detection()
    ]

    result = app.distance(
        None,
        detections
    )

    assert result[0]["distance_m"] == 0.2


def test_missing_estimator():

    app = make_app()

    detections = [
        make_detection()
    ]

    result = app.distance(
        None,
        detections
    )

    assert result[0]["distance_m"] is None


def test_proximity_alert():

    app = make_app()

    detections = [
        make_detection(distance=0.2),
        make_detection(distance=2.0),
    ]

    frame = np.zeros(
        (480, 640, 3),
        dtype=np.uint8
    )

    _, close_plants = app.proximity_alert(
        frame,
        detections
    )

    assert len(close_plants) == 1


def test_frontend_contract():

    frame = np.zeros(
        (480, 640, 3),
        dtype=np.uint8
    )

    interface = frontend.initialize_interface()

    interface["frame"] = frame

    interface["detections"] = [
        make_detection(distance=0.2)
    ]

    interface["dangerous_count"] = 1
    interface["unsafe_area"] = False
    interface["close_plants"] = [
        interface["detections"][0]
    ]

    interface = frontend.count_plants(
        interface
    )

    interface = frontend.set_status(
        interface
    )

    interface = frontend.mark_up(
        interface
    )

    assert interface["dangerous_count"] == 1

    assert (
        interface["status_text"]
        == "DANGER: TOO CLOSE - MOVE AWAY"
    )

    assert interface["annotated_frame"] is not None


def test_frontend_rejects_count_mismatch():

    interface = frontend.initialize_interface()

    interface["detections"] = [
        make_detection()
    ]

    interface["dangerous_count"] = 5

    with pytest.raises(ValueError):
        frontend.count_plants(interface)


def test_non_dangerous_plants_are_not_distance_checked():

    app = make_app()

    class MockEstimator:

        def estimate(self, bbox):
            return 0.1

    app.distance_estimator = MockEstimator()

    detections = [
        make_detection(
            hazard="non-dangerous"
        )
    ]

    app.distance(None, detections)

    assert detections[0]["distance_m"] is None
